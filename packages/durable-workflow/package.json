    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@zcd/runtime-settings": "workspace:*",
    "@zcd/shared": "workspace:*",
    "@zcd/workflow-store": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1"
  }

{
  "name": "zcd",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck": "pnpm -r --filter \"./packages/**\" run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify-naming.mjs && node scripts/check-docs.cjs",
    "runtime:ensure": "node scripts/ensure-runtime.mjs",
    "runtime:link": "node scripts/link-profile.mjs",
    "pack:product": "node scripts/pack-product.mjs",
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "smoke": "node scripts/smoke-profile.mjs",
    "profile": "node scripts/link-profile.mjs",
    "prep": "node scripts/ensure-runtime.mjs && node scripts/link-profile.mjs && node scripts/smoke-profile.mjs",
    "doctor": "node scripts/doctor-plugins.mjs",
    "mcp:install": "node scripts/install-mcp.mjs",
    "mcp:check": "node scripts/check-mcp.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.2-alpha.2",
    "@types/node": "^24.0.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
